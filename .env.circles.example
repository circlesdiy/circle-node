# Circles.DIY Environment Variables
# Copy this to .env.circles and update the values

# Server Configuration
PORT=8080
ENVIRONMENT=development  # development, staging, production

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=circles
DB_PASSWORD=circles_dev_password
DB_DATABASE=circles_diy
DB_SSL_MODE=disable

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# Authentication Configuration
WEBAUTHN_RP_NAME=Circles.DIY
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGIN=http://localhost:8080

# Security Configuration
# Generate a secure random string (32+ characters)
# Example: openssl rand -base64 32
CSRF_SECRET=change-this-to-a-random-32-byte-string

# Logging Configuration
LOG_LEVEL=info       # debug, info, warn, error
LOG_FORMAT=console   # console, json

# Docker Compose Variables
CIRCLES_DB_PASSWORD=circles_secure_password
DOCMOST_DB_PASSWORD=docmost_secure_password
POSTGRES_PASSWORD=postgres_root_password
DOMAIN=localhost
